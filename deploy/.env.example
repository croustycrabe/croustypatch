# CroustyPatch: copy to `.env` (cp .env.example .env && chmod 600 .env) and fill in the values below.
# No real secret is in this file: generate your own.

# ---- required --------------------------------------------------------------------------------------------------
# Database password.                        Generate: openssl rand -hex 24
CROUSTYPATCH_DB_PASSWORD=
# Master key, base64 of 32 bytes.           Generate: openssl rand -base64 32
# It encrypts sensitive values (for example the AI API key) and derives the session key.
# BACK IT UP SEPARATELY from the database: losing it makes encrypted values unrecoverable.
CROUSTYPATCH_MASTER_KEY=

# ---- image ------------------------------------------------------------------------------------------------------
# Version to run: a release tag such as 1.0.0 (recommended: pin one), or `latest`.
CROUSTYPATCH_VERSION=latest
# Image repository; change it only if you build or mirror the image yourself.
# CROUSTYPATCH_IMAGE=ghcr.io/croustycrabe/croustypatch-server

# ---- first login ------------------------------------------------------------------------------------------------
# Password of the first "admin" account, 12 characters or more (must be changed at first login).
# Leave empty to get a random one printed once in the server log: docker compose logs server | head -30
# Generate: openssl rand -base64 18
CROUSTYPATCH_BOOTSTRAP_PASSWORD=

# ---- network and TLS --------------------------------------------------------------------------------------------
# direct (default): the server serves HTTPS itself on the port below, with a self-signed certificate.
# proxy: plain HTTP for a reverse proxy that terminates TLS (then set CROUSTYPATCH_BIND=127.0.0.1 or a private
# address, and CROUSTYPATCH_TRUSTED_PROXIES below).
CROUSTYPATCH_TLS_MODE=direct
# Host port and address the server is published on.
CROUSTYPATCH_PORT=8443
CROUSTYPATCH_BIND=0.0.0.0
# direct mode: extra DNS names or IPs for the generated certificate (comma separated). Put the name your agents and
# browsers use, for example patch.example.org.
CROUSTYPATCH_TLS_SAN=localhost,127.0.0.1
# direct mode with your own certificate: see "Your own certificate" in README.md (CROUSTYPATCH_TLS_CERT and
# CROUSTYPATCH_TLS_KEY, set in a compose override together with the mounted files).
# proxy mode: address(es) of the reverse proxy as the container sees them (comma separated). With the port published
# by Docker this is usually the bridge gateway, for example 172.18.0.1; check the access log if the client address
# is wrong.
CROUSTYPATCH_TRUSTED_PROXIES=127.0.0.1,::1

# ---- other ------------------------------------------------------------------------------------------------------
# Time zone of the containers (logs); schedules in the UI have their own time zone setting.
TZ=UTC
