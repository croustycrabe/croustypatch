{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CroustyPatch",
  "version": "0.7.0",
  "identifier": "org.croustylab.croustypatch.portal",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "CroustyPatch", "width": 1120, "height": 740, "minWidth": 720, "minHeight": 480, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/icon.png"]
  }
}
