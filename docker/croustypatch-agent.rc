#!/bin/sh
# FreeBSD rc.d script: install as /usr/local/etc/rc.d/croustypatch_agent (mode 555)
#
# PROVIDE: croustypatch_agent
# REQUIRE: NETWORKING DAEMON
# KEYWORD: shutdown
#
# rc.conf:  croustypatch_agent_enable="YES"
#
# Quarantine uses pf: add this to /etc/pf.conf and enable pf, otherwise isolation cannot take effect:
#     anchor "croustypatch_quarantine"

. /etc/rc.subr

name="croustypatch_agent"
rcvar="croustypatch_agent_enable"
pidfile="/var/run/${name}.pid"
command="/usr/sbin/daemon"
command_args="-r -P ${pidfile} -u root -t croustypatch-agent /usr/local/bin/croustypatch-agent --config /usr/local/etc/croustypatch/agent.toml --state-dir /var/db/croustypatch run"

load_rc_config $name
: ${croustypatch_agent_enable:="NO"}
run_rc_command "$1"
