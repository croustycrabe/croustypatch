# /etc/systemd/system/croustypatch-server.service  (bare-metal install; Docker users do not need this)
[Unit]
Description=CroustyPatch server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=croustypatch
Group=croustypatch
# DATABASE_URL, CROUSTYPATCH_MASTER_KEY, TLS paths ... (file mode 600, owned by root)
EnvironmentFile=/etc/croustypatch/server.env
Environment=CROUSTYPATCH_DATA_DIR=/var/lib/croustypatch CROUSTYPATCH_STATIC_DIR=/usr/share/croustypatch/web
ExecStart=/usr/local/bin/croustypatch-server serve
Restart=always
RestartSec=5
StateDirectory=croustypatch
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
